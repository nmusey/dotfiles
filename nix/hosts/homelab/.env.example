# Uploaded to /etc/homelab/homelab.env by `make secrets`. Shared by
# miniflux, readeck, searxng and restic (each reads only its own keys).

# Deployment (Makefile)
# If ~/.ssh/config has a `Host homelab` entry, the Makefile uses it and
# ignores everything below. SSH_HOST picks a different Host entry name.
# Otherwise it connects to DEPLOY_USER@HOST_IP with DEPLOY_PORT and SSH_KEY.
HOST_IP=
SSH_HOST=homelab
DEPLOY_USER=
DEPLOY_PORT=22
SSH_KEY=~/.ssh/id_ed25519

# Miniflux first admin account (password at least 6 characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Readeck / SearXNG (`openssl rand -hex 32` for each)
READECK_SECRET_KEY=
SEARX_SECRET_KEY=

# restic: repository password, used by both the local and offsite backups.
# Do not set RESTIC_REPOSITORY here; repositories are set in nix
# (modules.homelab.restic.*Repository). Add the offsite backend's
# credentials below, e.g. for B2/S3:
RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Proton VPN: not set here. Download a WireGuard config from
# account.protonvpn.com and save it next to this file as proton.conf;
# `make secrets` uploads it to /etc/homelab/proton.conf.
