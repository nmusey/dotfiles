{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permission": {
      "external_directory": {
          "~/Developer/**": "allow"
      }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B",
          "tools": true
        },
        "qwen3.5:4b-q8_0": {
            "name": "Qwen3.5 4B",
            "tools": true
        },
        "granite4.1:8b": {
            "name": "Granite 4.1",
            "tools": true
        },
        "deepseek-coder-v2:16b-lite-base-q2_K": {
            "name": "Deepseek Coder V2",
            "tools": true
        }
      }
    }
  }
}


