# mako notification daemon — deployed with `stow mako`
# Colors are generated by pywal (see ~/.cache/wal/colors-mako).

include=~/.cache/wal/colors-mako

font=monospace 10
width=340
height=120
margin=12
padding=12,16
border-size=1
border-radius=8

anchor=top-right
layer=overlay
max-visible=5
default-timeout=5000
ignore-timeout=0

[urgency=low]
default-timeout=3000

[urgency=critical]
default-timeout=0
border-size=2
